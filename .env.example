# Copy to .env and fill in. .env itself is gitignored -- never commit real keys.

# --- LLM (any OpenAI-compatible endpoint) -----------------------------------
# OpenAI:
OPENAI_API_KEY=sk-...
# Or provider-agnostic (Groq free tier shown; also works for Together, etc.):
# LLM_API_KEY=gsk_...
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile

# --- Tracing (optional, off by default) -------------------------------------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=cyber-risk-copilot

# --- Tier 2 eval (scripts/eval_faithfulness_deepeval.py only) ---------------
DEEPEVAL_JUDGE_MODEL=gpt-4o-mini

# --- Observability (see src/risk_engine/observability.py) -------------------
LOG_LEVEL=INFO
LOG_FORMAT=text
# Slack-compatible incoming webhook for operational alerts (KEV feed down,
# dense retrieval degraded, LLM fallback rate high, ...). Leave unset to
# only log these (still visible at LOG_LEVEL=WARNING).
ALERT_WEBHOOK_URL=
