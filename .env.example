# Copy to .env and fill in. .env itself is gitignored -- never commit real keys.

# --- LLM (any OpenAI-compatible endpoint) -----------------------------------
# OpenAI:
OPENAI_API_KEY=sk-...
# Or provider-agnostic, free-tier -- assignment-compliant (check
# https://console.groq.com/docs/models for the current model list; Groq
# retires/renames models over time, confirm before assuming a name works):
# LLM_API_KEY=gsk_...
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b

# --- Tracing (optional, off by default) -------------------------------------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=cyber-risk-copilot

# --- Tier 2 eval (scripts/eval_faithfulness_deepeval.py only) ---------------
# Judge is deliberately independent of the generator above -- both a
# different model AND (by default) a different provider/endpoint, so a
# model never grades its own homework. Defaults to OPENAI_API_KEY against
# OpenAI's real endpoint regardless of what LLM_BASE_URL points at; only
# set these two if you want the judge somewhere else entirely.
DEEPEVAL_JUDGE_MODEL=gpt-4o
# DEEPEVAL_JUDGE_API_KEY=sk-...
# DEEPEVAL_JUDGE_BASE_URL=https://api.openai.com/v1

# --- Observability (see src/risk_engine/observability.py) -------------------
LOG_LEVEL=INFO
LOG_FORMAT=text
# Slack-compatible incoming webhook for operational alerts (KEV feed down,
# dense retrieval degraded, LLM fallback rate high, ...). Leave unset to
# only log these (still visible at LOG_LEVEL=WARNING).
ALERT_WEBHOOK_URL=
